# Copy to .env and fill in. Real env vars always win over this file.
APP_PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgres://postgres:postgres@localhost:5434/app
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/app_test

# ── OpenAI (required when MAIL_ENABLED=true) ──────────────────────────
OPENAI_API_KEY=

# ── Mail processing (optional) ────────────────────────────────────────
# false keeps the worker on the heartbeat-only path. true enables the scheduled
# Gmail sync coordinator/jobs and requires the Gmail Desktop OAuth client below
# plus OPENAI_API_KEY. Accounts can be connected with MAIL_ENABLED=false.
# See docs/GMAIL-SETUP.md.
MAIL_ENABLED=false
MAIL_MODEL=gpt-6-luna
# medium (default) or high
MAIL_REASONING_EFFORT=medium
MAIL_MAX_INPUT_CHARS=12000
MAIL_MAX_OUTPUT_TOKENS=2000
MAIL_REQUEST_TIMEOUT_MS=90000

# ── Telegram ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Numeric chat ID the bot is locked to (the private chat with your bot).
TELEGRAM_CHAT_ID=

# ── Runtime worker ─────────────────────────────────────────────────────
# Daily heartbeat, UTC. It is the dead-man's switch; keep the daily default.
# Use "*/2 * * * *" temporarily for the scheduled exit test.
HEARTBEAT_CRON="0 9 * * *"
# With the worker running: pnpm smoke:heartbeat (exits 0 only when the outbox row is sent).
# AES-256-GCM key ring: comma-separated version:base64key pairs.
# Generate a 32-byte key with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_ACTIVE_KEY_VERSION=1

# ── Health ─────────────────────────────────────────────────────────────
# Optional bearer token for /health/details. Leave empty to disable that route.
HEALTH_DETAILS_TOKEN=

# ── Gmail Desktop OAuth ──────────────────────────────────────────────
# Required for pnpm gmail:connect and for the worker when MAIL_ENABLED=true.
# Create a Desktop OAuth client and follow docs/GMAIL-SETUP.md.
# Connect with: pnpm gmail:connect --email <address>
# Refresh/access tokens are stored encrypted in the DB, never here.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ── Browser agent (phase 05; off by default) ──────────────────────────
# When AGENT_ENABLED=true the worker also requires OPENAI_API_KEY, AGENT_MODEL (must have a
# pricing snapshot in src/llm/pricing.ts), AGENT_TASK_MAX_USD, BROWSER_VIEW_URL, ARTIFACT_DIR.
AGENT_ENABLED=false
AGENT_MODEL=
AGENT_REASONING_EFFORT=medium
AGENT_MAX_STEPS=25
AGENT_MAX_OUTPUT_TOKENS=4000
AGENT_STEP_TIMEOUT_MS=90000
# rules (default) or llm: rules tries the model-free registry fast path before the model loop
# and hands off once on anything it cannot choose (D056, D058); llm runs the model loop alone.
AGENT_STEP_POLICY=rules
# Per-task model-spend cap in USD; the daily agent sub-limit lives in user_settings.
AGENT_TASK_MAX_USD=
# Loopback only. pnpm browser:up publishes CDP on 127.0.0.1:9222.
BROWSER_CDP_URL=http://127.0.0.1:9222
# https://<host>.<tailnet>.ts.net from `tailscale serve --bg --https=443 http://127.0.0.1:3010`.
# Never put credentials in this URL; it is sent to Telegram as a button.
BROWSER_VIEW_URL=
# Absolute path for screenshots (created with mode 0700).
ARTIFACT_DIR=
BROWSER_HANDOFF_TIMEOUT_MINUTES=15
BROWSER_APPROVAL_TIMEOUT_MINUTES=30
# Basic auth for the browser web view, read by docker-compose.browser.yml. Use a long random
# password (openssl rand -hex 24). Never commit real values.
BROWSER_VIEW_USER=
BROWSER_VIEW_PASSWORD=
