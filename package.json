{
  "name": "agent-automation",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "smoke:heartbeat": "tsx src/tools/smoke-heartbeat.ts",
    "gmail:connect": "tsx src/tools/gmail-connect.ts",
    "mail:accounts": "tsx src/tools/mail-accounts.ts",
    "mail:config": "tsx src/tools/mail-config.ts",
    "mail:triage": "tsx src/tools/mail-triage.ts",
    "mail:evaluate": "tsx src/tools/mail-evaluate.ts",
    "browser:check": "tsx src/tools/browser-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "browser:up": "docker compose -f docker-compose.browser.yml up -d --build --wait",
    "browser:down": "docker compose -f docker-compose.browser.yml down",
    "agent:profile": "tsx src/tools/agent-profile.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/provider": "4.0.26",
    "@googleapis/gmail": "^22.0.2",
    "@hono/node-server": "^2.1.3",
    "ai": "7.0.137",
    "cron-parser": "5.10.2",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.1",
    "grammy": "^1.46.0",
    "hono": "^4.13.13",
    "html-to-text": "^10.0.1",
    "openai": "^7.34.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "playwright-core": "1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
